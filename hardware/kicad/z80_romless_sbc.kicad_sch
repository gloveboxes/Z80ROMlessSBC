	(text "J2: 3.3V expansion/probe header, not a 5V input.\n1: GP22/SDA; 2: GP26/SCL, shared with A2.\n3: Pico 3V3 output; 4: GND.\nGP8 is dedicated to SRAM bank select."
		(exclude_from_sim no)
		(at 1016 190.5 0)
