	(text "RN1-RN4: address, data and control bias. RN5: four 3V3 startup pull-ups (breadboard R17-R20). RN6: four startup pull-downs (breadboard R21-R24). Both data paths default disabled."
		(exclude_from_sim no)
		(at 50.8 622.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fe5fa21b-fd2d-53ef-bade-473c324db25e")
	)
	(text "A2: socketed Stage 10 0.91in SSD1315 128x32 status OLED.\nModule 38.00 x 12.00 mm; 4-pin 2.54 mm header.\nHeader centres 1.50mm from left; SDA 2.19mm from top.\nHeader order GND, VCC, SCK, SDA bottom-to-top.\nSDA = J2.1 / GP22; SCK = J2.2 / GP26.\nVCC = J2.3 / 3V3; GND = J2.4 / GND.\nI2C pull-ups to 3.3V only; address 0x3C.\nVerify socket height, pin fit and insulated module support."
		(exclude_from_sim no)
		(at 1016 292.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ff71bf7f-4ab9-5e88-97b5-cf64dc528438")
	)
