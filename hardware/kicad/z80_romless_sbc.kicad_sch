	)
	(text "BANK SELECT: Pico physical pin 11 / GP8 -> U4.17.\nRN6.5: 10k to RN6.1 / GND (breadboard R24 equivalent).\nU4.3 -> U2.2 / A16 (5V side); LOW selects bank 0."
		(exclude_from_sim no)
		(at 787.4 254 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "33010ba5-5049-529c-89eb-b637746af894")
	)
	(text "CPU_TO_BUFFERS"
		(exclude_from_sim no)
		(at 330.2 304.8 0)
		(effects
