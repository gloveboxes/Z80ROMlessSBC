	)
	(text "Z80 is the sole SRAM address/write master. Pico injects instructions with SRAM reads inhibited. RESET_N directly joins Pico and Z80 at 3.3V."
		(exclude_from_sim no)
		(at 508 38.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
