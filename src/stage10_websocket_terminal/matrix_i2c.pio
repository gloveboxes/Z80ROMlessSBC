.program matrix_i2c
.side_set 1 opt pindirs

.wrap_target
program_loop:
    pull block
    out x, 2
    jmp !x write_byte
    set y, 1
    jmp x!=y stop_condition

start_condition:
    set pindirs, 1 side 0 [5]
    set pindirs, 1 side 1 [2]
    jmp program_loop

stop_condition:
    set pindirs, 1 side 1 [1]
    nop side 0 [5]
    set pindirs, 0 side 0 [5]
    jmp program_loop

write_byte:
    set x, 7 side 1
bit_loop:
    out pindirs, 1 side 1 [1]
    nop side 0 [5]
    nop side 1 [1]
    jmp x-- bit_loop side 1 [1]
    set pindirs, 0 side 1 [1]
    nop side 0 [5]
    mov isr, null side 0
    in pins, 1 side 0
    nop side 1 [1]
    push block side 1
    jmp program_loop
.wrap
