.program display_i2c
.side_set 1 opt pindirs

.wrap_target
program_loop:
    pull block
    out x, 2
    jmp !x write_byte
    set y, 1
    jmp x!=y stop_condition

start_condition:
    wait 1 gpio 26 side 0
    set pindirs, 1 side 0 [5]
    set pindirs, 1 side 1 [2]
    jmp program_loop

stop_condition:
    set pindirs, 1 side 1 [6]
    wait 1 gpio 26 side 0 [5]
    set pindirs, 0 side 0 [6]
    mov isr, null
    push block
    jmp program_loop

write_byte:
    set x, 7 side 1
bit_loop:
    ; 7 cycles LOW, 5 HIGH, extended by the slave's clock stretching.
    out pindirs, 1 side 1 [2]
    wait 1 gpio 26 side 0 [3]
    in pins, 1 side 0
    jmp x-- bit_loop side 1 [3]
    ; Ninth output bit: release for write ACK/read NACK, drive for read ACK.
    out pindirs, 1 side 1 [2]
    wait 1 gpio 26 side 0 [4]
    in pins, 1 side 0 [1]
    nop side 1 [1]
    push block side 1
    jmp program_loop
.wrap
