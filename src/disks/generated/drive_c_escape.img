        CALL    COUTS
        LHLD    LINES           ; counter = LINES + 1␀вEF      INX     H
        CALL    PRDEC
        LXI     H,SUFFIX        ; ESC [ 0 m CR LF
        CALL    COUTS
        LH␀ЎEF  LINES           ; LINES = LINES + 1
        INX     H
        SHLD    LINES
        LDA     CIDX            ; advance c␀аEF index (mod NCOLOR)
        INR     A
        CPI     NCOLOR
        JC      CSET
        XRA     A
CSET:   STA     CID␀AEF       CALL    CKESC           ; ESC pressed?
        ORA     A
        JNZ     LESC            ; yes -> stop early
     ␀IEFMP     LOOP
LESC:   MVI     A,1
        STA     ESCFLG          ; remember ESC so we don't rerun
        JMP     LDONE
␀ъEF-- latch elapsed seconds, keep the low 16 bits ------------------------
LDONE:  MVI     A,1
        OUT     SWPORT        ␀EFOUT 37,1 -> latch elapsed seconds
        IN      RDPORT          ; byte 0 (MSB) - ignore
        IN      RDPORT          ␀БEFte 1       - ignore
        IN      RDPORT          ; byte 2
        MOV     H,A
        IN      RDPORT          ; byte 3␀{EFB)
        MOV     L,A
        SHLD    ELAPS           ; HL = elapsed seconds (low 16 bits)

