␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀€TTНu]E.€и–Ї£Мu_I2сџ≈∞ЪЕp[F1уя ґҐОzfR?+сёЋЄ•ТmZH5#€мЏ…Ј•␀эTTp_M<+ч␀ж␀’␀≈␀і␀£␀У␀В␀r␀a␀Q␀A␀0␀ ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀«NTe while this program runs, then restore CP/M's original bytes.
; The ISR must not call BDOS because it can interrupt BDOS i␀шNTf.

BDOS    EQU     5
FPRINT  EQU     9
INTPRT  EQU     52
INTVEC  EQU     0038H
TARGET  EQU     50

        ORG    ␀ЧNT0H

START:  DI
        LDA     INTVEC
        STA     OLDVEC
        LDA     INTVEC+1
        STA     OLDVEC+1
      ␀dNTA     INTVEC+2
        STA     OLDVEC+2

        MVI     A,0C3H         ; JP ISR
        STA     INTVEC
        LXI    ␀wNTSR
        SHLD    INTVEC+1

        LXI     D,MESSAGE
        MVI     C,FPRINT
        CALL    BDOS

        MVI    ␀qNT0           ; 10 interrupts per second
        OUT     INTPRT
        DB      0EDH,056H      ; IM 1 (MAC has no Z80 mnemon␀иNT
        EI

WAITT:  HLT                     ; timer interrupt resumes at the next instruction
        LHLD    TICKS
   ␀NT LXI     D,TARGET
        MOV     A,H
        CMP     D
        JNZ     WAITT
        MOV     A,L
        CMP     E
  ␀bNT  JNZ     WAITT

CLEAN:  DI
        XRA     A
        OUT     INTPRT         ; stop source and discard pending ticks
  ␀ЧNT  LDA     OLDVEC
        STA     INTVEC
        LDA     OLDVEC+1
        STA     INTVEC+1
        LDA     OLDVEC+2
    ␀2NTSTA     INTVEC+2

        LXI     D,COUNTM
        MVI     C,FPRINT
        CALL    BDOS
        LHLD    TICKS
       ␀«NTL    PHWORD
        LXI     D,CRLF
        MVI     C,FPRINT
        CALL    BDOS
        RET

ISR:    PUSH    PSW
   ␀ђNT PUSH    B
        PUSH    D
        PUSH    H
        LHLD    TICKS
        INX     H
        SHLD    TICKS
