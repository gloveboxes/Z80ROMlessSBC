; The ISR must not call BDOS because it can interrupt BDOS itself.

BDOS    EQU     5
FPRINT  EQU     9
INTPRT  EQU     52
INTVEC  EQU     0038H
TARGET  EQU     50

        ORG     0100H

START:  DI
        LDA     INTVEC
        STA     OLDVEC
        LDA     INTVEC+1
        STA     OLDVEC+1
        LDA     INTVEC+2
        STA     OLDVEC+2

        MVI     A,0C3H         ; JP ISR
        STA     INTVEC
        LXI     H,ISR
        SHLD    INTVEC+1

        LXI     D,MESSAGE
        MVI     C,FPRINT
        CALL    BDOS

        MVI     A,10           ; 10 interrupts per second
        OUT     INTPRT
        DB      0EDH,056H      ; IM 1 (MAC has no Z80 mnemonic)
        EI

WAITT:  HLT                     ; timer interrupt resumes at the next instruction
        LHLD    TICKS
        LXI     D,TARGET
        MOV     A,H
        CMP     D
        JNZ     WAITT
        MOV     A,L
        CMP     E
        JNZ     WAITT

CLEAN:  DI
        XRA     A
        OUT     INTPRT         ; stop source and discard pending ticks
        LDA     OLDVEC
        STA     INTVEC
        LDA     OLDVEC+1
        STA     INTVEC+1
        LDA     OLDVEC+2
        STA     INTVEC+2

        LXI     D,COUNTM
        MVI     C,FPRINT
        CALL    BDOS
        LHLD    TICKS
        CALL    PHWORD
        LXI     D,CRLF
        MVI     C,FPRINT
        CALL    BDOS
        RET

ISR:    PUSH    PSW
        PUSH    B
        PUSH    D
        PUSH    H
        LHLD    TICKS
        INX     H
        SHLD    TICKS
        POP  nЁfлЁnЁf~Ј !–К√ГЁnЁfеЁеб“€еЌ?*ЅЅЁnЁf	еЌb'ЅЁuќЁtѕеЁеб“€—n&␀ЁuћЁtЌЁnЁf	еЁnЁfеЁеб“€еЌb*ЅЅЅЁu ЁtЋЁnќЁfѕеЁеб“€—n&␀Ё^ћЁVЌЈнRЁuћЁtЌT]))))))еЁnЁfлЁnЁfn&␀е—бЁuќЁtѕЁuƒЁt≈Ёn ЁfЋ␀ЈнR ЁnќЁfѕ<␀ЁuƒЁt≈Ё~ЋЁґ ¬}Ёебя€n&␀ЁuќЁtѕЁеб“€␀n&␀ЁuћЁtЌЁnќЁfѕЁuќЁtѕЁnћЁfЌлЁnќЁfѕЈнRЁuќЁtѕЁnƒЁf≈ЁuћЁtЌЁnќЁfѕЋ| ЁnќЁfѕЁu ЁtЋЁnќЁfѕѓХoЯФgЁu ЁtЋЁn ЁfЋT]))))лЁnћЁfЌЁuƒЁt≈ЁnƒЁf≈ЁщЁб…ЁеЁ!␀␀Ё9эе!д€9щЁ6ь␀Ё6э␀ЁnЁf|µ Ё6шЁ6щ␀Ё6ъ␀Ё6ы␀Ё6шЁ6щ␀Ё6ъЁ6ы␀ЁnъЁfыеэбэебЁ^шЁVщ}У|ЪвжоА“ZэеЁnЁf—n&␀ЁuжЁtз|µ UЋ|¬UЁnьЁfэ)лЁnЁf	еэеблбs#rЁnьЁfэ)еЁебм€—еЁnЁfеэеЁnЁfеЌџЅЅЅе—бs#rЁ4ь Ё4ээ#√‘Ё6ъ␀Ё6ы␀ЁNьЁFэi`+лЁnъЁfы|оАgzоАWнR“ЁnъЁfы#ЁuдЁtеЁnдЁfеYP}У|ЪвЭоА“фЁnЁf␀ЈнR¬мЁnдЁfе)еЁебм€—~#foеЁnъЁfы)еЁебм€—~#foе—бл}У|ЪвиоАЏ2ЁnЁf|µ¬иЁnдЁfе)еЁебм€—~#foеЁnъЁfы)еЁебм€—~#foе—б}У|Ъв.оА“иЁnъЁfы)еЁебм€—~#foеэбЁnъЁfы)еЁебм€—еЁnдЁfе)еЁебм€—~#foе—бs#rЁnдЁfе)еЁебм€—еэеблбs#rЁnъЁfы)лЁnЁf	~#foеэбЁnъЁfы)лЁnЁf	еЁnдЁfе)лЁnЁf	~#foе—бs#rЁnдЁfе)лЁnЁf	еэеблбs#rЁ4д¬МЁ4е√МЁnъЁfы#ЁuъЁtы√hЁnьЁfэЁщ;;эбЁб…!,␀еЌ…Ѕ!a␀еЌ…Ѕ…!)␀еЌ…Ѕ!a␀еЌ…Ѕ…ЁеЁ!␀␀Ё9Ёn&␀Ќ]еЁn&␀Ќ]е—б␀|Ґg}£o|µ(Ёn&␀}жo|µ(!*␀!+␀Ёn&␀}жo|µ(!)␀!,␀Ёб…ЁеЁ!␀␀Ё9!№€9щ!␀␀ЁuяЁ~яюP“*o&␀Ќ]&␀е!␀␀еЌ5ЅЅеЌ…ЅЁnя&␀#&␀е!␀еЌКЅЅ!„9еЌ!ЅЁnя&␀Ќ]&␀е!␀еЌ5ЅЅеЌ…ЅЁnя&␀#&␀е!␀еЌКЅЅ!„9еЌ!ЅЁnя&␀##&␀Ёu№ЁtЁЁuя√•!␀ЁuёЁ~ёю“Ѓo&␀␀ЈнR&␀␀␀’еЌ5ЅЅеЌ…Ѕ!␀еЁnё&␀еЌКЅЅ!„9еЌ!ЅЁnё&␀␀ЈнR&␀'␀’еЌ5ЅЅеЌ…Ѕ!O␀еЁnё&␀еЌКЅЅ!„9еЌ!ЅЁnё&␀#Ёu№ЁtЁЁuё√0ЌцЁщЁб…Ќц!%␀еЌ…Ѕ!␀␀’еЌКЅЅ!о9еЌ!Ѕ!␀1␀’еЌКЅЅ!:еЌ!Ѕ!ы\n&␀еЌ[Ѕ!:еЌ!Ѕ!]n&␀еЌ[Ѕ!„9еЌ!Ѕ*]␀␀|µ !Џ9еЌ!Ѕ√'*]␀ЈнR !б9еЌ!Ѕ√'!з9еЌ!Ѕ√'ЁеЁ!␀␀Ё9!ъ€9щЁnЁfА|оАgнR0ЁnЁfЁuьЁtэЁ6ьЁ6э␀Ё6ю␀Ё6€␀ЁnюЁf€Ё^ьЁVэ|оАgzоАWнR8ЁnюЁf€ЁuьЁtэ!o␀еЌЦЅЁnюЁf€#ЁuъЁtыЁuюЁt€√ГЁnьЁfэА|оАgнR0! ␀еЌЦЅЁnьЁfэ#ЁuьЁtэ√«ЁщЁб…ЁеЁ!␀␀Ё9!ч€9щЁnЁf␀ЈнR 
