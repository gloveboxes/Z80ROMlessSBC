b:submit attn
␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀Нu]E.€и–Ї£Мu_I2сџ≈∞ЪЕp[F1уя ґҐОzfR?+сёЋЄ•ТmZH5#€мЏ…Ј•УВp_M<+ч␀ж␀’␀≈␀і␀£␀У␀В␀r␀a␀Q␀A␀0␀ ␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀␀e while this program runs, then restore CP/M's original bytes.
; The ISR must not call BDOS because it can interrupt BDOS itself.

BDOS    EQU     5
FPRINT  EQU     9
INTPRT  EQU     52
INTVEC  EQU     0038H
TARGET  EQU     50

        ORG     0100H

START:  DI
        LDA     INTVEC
        STA     OLDVEC
        LDA     INTVEC+1
        STA     OLDVEC+1
        LDA     INTVEC+2
        STA     OLDVEC+2

        MVI     A,0C3H         ; JP ISR
        STA     INTVEC
        LXI     H,ISR
        SHLD    INTVEC+1

        LXI     D,MESSAGE
        MVI     C,FPRINT
        CALL    BDOS

        MVI     A,10           ; 10 interrupts per second
        OUT     INTPRT
        DB      0EDH,056H      ; IM 1 (MAC has no Z80 mnemonic)
        EI

WAITT:  HLT                     ; timer interrupt resumes at the next instruction
        LHLD    TICKS
        LXI     D,TARGET
        MOV     A,H
        CMP     D
        JNZ     WAITT
        MOV     A,L
        CMP     E
        JNZ     WAITT

CLEAN:  DI
        XRA     A
        OUT     INTPRT         ; stop source and discard pending ticks
        LDA     OLDVEC
        STA     INTVEC
        LDA     OLDVEC+1
        STA     INTVEC+1
        LDA     OLDVEC+2
        STA     INTVEC+2

        LXI     D,COUNTM
        MVI     C,FPRINT
        CALL    BDOS
        LHLD    TICKS
        CALL    PHWORD
        LXI     D,CRLF
        MVI     C,FPRINT
        CALL    BDOS
        RET

ISR:    PUSH    PSW
        PUSH    B
        PUSH    D
        PUSH    H
        LHLD    TICKS
