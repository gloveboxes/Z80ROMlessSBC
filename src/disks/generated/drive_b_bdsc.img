ЌЮ*…ч€€€€€€п€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€wч€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€sч€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€€Z     PRD1            ; until quotient == 0
PRD2:   LDAX    D               ; print digits DE .. NMEND-1
        MOV     C,A
        CALL    COUT
        INX     D
        MOV     A,E             ; DE == NMEND ?
        LXI     H,NMEND
        CMP     L
        JNZ     PRD2
        MOV     A,D
        CMP     H
        JNZ     PRD2
        POP     B
        POP     D
        POP     H
        RET

