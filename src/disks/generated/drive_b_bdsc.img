; SHR3 - HL = HL >> 3 (logical).  Z80 SRL H / RR L, DJNZ x3.
; ==========␀-TT        RL      (HL)
        RET

; ==========================================================================
; FXDIV -␀3TT= (a << 8) / b, unsigned, clamp to int16.
;         Input: HL = a (>=0), DE = b (>0).
;         Z80: SBC HL,DE compare, SE␀TT at (HL) <<= 1, MSB -> carry.  Z80 SLA/RL on (HL).
; ======================================================================␀%TT
SHL32:  SLA     (HL)
        INC     HL
        RL      (HL)
        INC     HL
        RL      (HL)
        INC     ␀ENT0005 BDOS	013F CLEAN	01C9 COUNTM	01E3 CRLF	0009 FPRINT
0034 INTPRT	0038 INTVEC	01EA ISR	01A6 MESSAGE	01A3 OLDVEC
0185 PHBY␀NT192 PHNIB	019B PHOUT	01F8 P		017E PHWORD
0100 START	0032 TARGET	01A1 TICKS	012C WAITT
␀ЊTT   LD      (NUM+2),A       ; NUM = a << 8
        EX      DE,HL
        LD      (DVS),HL        ; DVS = b
        LD     ␀—TT0            ; REM = 0
        LD      A,32
        LD      (FXCNT),A
FXLP:   LD      HL,NUM          ; NUM <<= 1, MSB ->␀°TTry (BC untouched)
        CALL    SHL32
        RL      C               ; REM = (REM<<1) | carry
        RL      B
     ␀6TTD      H,B
        LD      L,C             ; HL = REM
        LD      DE,(DVS)        ; DE = DVS
        OR      A       ␀ТTT    ; clear carry
        SBC     HL,DE           ; HL = REM - DVS, carry = borrow
        JR      C,FXSKIP        ; REM <␀}TT
        LD      B,H
        LD      C,L             ; REM = REM - DVS
        LD      HL,NUM
        SET     0,(HL)    ␀≈TT  ; quotient bit
FXSKIP: LD      A,(FXCNT)
        DEC     A
        LD      (FXCNT),A
        JP      NZ,FXLP
        ␀`TT    A,(NUM+2)       ; clamp quotient to int16
        LD      B,A
        LD      A,(NUM+3)
        OR      B
        JR␀ИTT  NZ,FXBIG
        LD      HL,(NUM)
        BIT     7,H
        JR      NZ,FXBIG
        RET
FXBIG:  LD      HL,7FFFH
␀’TT    RET

