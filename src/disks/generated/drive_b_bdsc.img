        ORA     A
        JZ      CKNO            ; no character ready
        CALL    CONIN
        CPI     ESC
        JZ      CKYES
CKNO:   XRA     A
        RET
CKYES:  MVI     A,1
        RET

; ============================================================================
; CRLF - carriage return + line feed via CONOUT
; ============================================================================
CRLF:   MVI     C,13
        CALL    COUT
        MVI     C,10
        CALL    COUT
        RET

; ============================================================================
; PSTR - print the '$'-terminated string at DE via BDOS func 9
; ============================================================================
PSTR:   Pgf -f $1.asm
d:mac $1
d:load $1
era $1.prn
era $1.hex
era $1.sym
era $1.asm

