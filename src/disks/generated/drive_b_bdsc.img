␀␀␀␀␀␀␀␀␀␀␀␀␀␀ҐTDommand-line arguments
; ============================================================================
; MAC (macro assemble␀ќTDAC macros for the BDOS calls. Build it
; with the macro assembler rather than ASM:
;
;   mac mcpdone        ->  MCPDONE.H␀÷TDplus .PRN/.SYM)
;   load mcpdone       ->  MCPDONE.COM
;
; MAC constraints: symbols unique in first 6 chars; ports in dec␀1TDcters typed after the program name (already upper-cased). We
; reproduce the C argv behaviour by walking that tail, collaps␀TDruns of
; spaces, and emitting exactly one leading space before each argument token.
;
; This version uses Digital Resear␀@TDfunc 9: print '$'-terminated string
TAILLN  EQU     0080H           ; command tail length byte
TAILCH  EQU     0081H      ␀іTD ; first character of the command tail
SPACE   EQU     ' '

; -- macro: invoke a BDOS function --------------------------␀}TD.
; ============================================================================

BDOS    EQU     5               ; CP/M ␀ЧTD entry point
FPRCHR  EQU     2               ; BDOS func 2: console output (char in E)
FPRSTR  EQU     9               ; B␀дTD

; -- macro: print the character in E (preserves HL and BC) -----------------
EMITCH  MACRO
        PUSH    H
        P␀TD   B
        DOS     FPRCHR
        POP     B
        POP     H
        ENDM

        ORG     0100H           ; CP/M t␀CTD-----------
DOS     MACRO   FUNC
        MVI     C,FUNC
        CALL    BDOS
        ENDM

; -- macro: print a '$'-ter␀.TDted string at label STR ---------------------
PRINT   MACRO   STR
        LXI     D,STR
        DOS     FPRSTR
