PRINT   MACRO   STR
        LXI     D,STR
        DOS     FPRSTR
        ENDM

; -- macro: print the character in E (preserves HL and BC) -----------------
EMITCH  MACRO
        PUSH    H
        PUSH    B
        DOS     FPRCHR
        POP     B
        POP     H
        ENDM

        ORG     0100H           ; CP/M transgf -f $1.c
cc $1   
clink $1       dxtimer dxterm long
