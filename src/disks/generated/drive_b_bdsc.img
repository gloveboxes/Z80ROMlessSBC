        CALL    CONIN
        CPI  ␀оEFSC
        JZ      CKYES
CKNO:   XRA     A
        RET
CKYES:  MVI     A,1
        RET

; ===========================␀␀EF=============================================
; CRLF - carriage return + line feed via CONOUT
; ==========================␀НEF==============================================
CRLF:   MVI     C,13
        CALL    COUT
        MVI     C,10
        CA␀ьEF  COUT
        RET

; ============================================================================
; PSTR - print the '$␀ЏEFrminated string at DE via BDOS func 9
; ============================================================================
PSTR:␀ІTDort of MCPDONE.C, feature for feature:
;
;   printf("MCP-TOOL-COMPLETED");
;   for (i = 1; i < argc; i++)
;       printf␀cTDs", argv[i]);
;   printf("\n");
;
; The CP/M CCP places the command tail at 0080H: a length byte followed by
; the raw c␀ЬTDgf -f $1.asm
d:mac $1
d:load $1
era $1.prn
era $1.hex
era $1.sym
era $1.asm

