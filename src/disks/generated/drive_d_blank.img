␀Singh␀MorCardiology␀Paediatri10200031030␀␀003Clara␀DanielSingh␀Morgan␀RosPaediatrics␀Dermatol10300061030␀␀004Daniel␀ElenaMorgan␀Rossi␀KhaDermatology␀Women's 10400091030␀␀005Elena␀Farid␀Rossi␀Khan␀Chen␀Women's Health␀Respi10500121030␀␀006Farid␀Grace␀Khan␀Chen␀DaviesRespiratory␀Diabetes10600151030␀␀007Grace␀Hugo␀HChen␀Davies␀GeneDiabetes␀Mental Heal10700181030␀␀008Hugo␀Hart␀OkDavies␀General PMental Health␀Alex␀B10800211030␀␀a,(pf_prec)
        or      a
        jr      z,pf_d_print    ; prec=0: no zero-fill
        ld      d,a             ; D = prec (DE preserved across pf_emit_a)
        ld      a,(pf_digit)
        sub     d               ; A = digit_count - prec
        jr      nc,pf_d_print   ; digit_count >= prec: no fill
        neg                     ; A = prec - digit_count (zeros needed)
        ld      d,a
pf_d_zero_loop:
        ld      a,'0'
        call    pf_emit_a       ; push de/pop de preserves D
        dec     d
        jr      nz,pf_d_zero_loop
pf_d_print:
        call    pf_print_u
        pop     de
        pop     hl
        jp      pf_loop

pf_x:
        push    hl
        call    pf_arg_hl
        push    de
        ld      a,4
        call    pf_pad_a
        call    pf_print_x
        pop     de
        pop     hl
        jp      pf_loop

pf_l:
        ; 'l' length modifier: read next char for ld/lu/lx/ls
        ld      a,(hl)
        inc     hl
        cp      'd'
        jp      z,pf_ld
        cp      'u'
        jp      z,pf_lu
        cp      'x'
        jp      z,pf_lx
        cp      's'
        jp      z,pf_ls
        call    pf_emit_a
        jp      pf_loop

pf_ls:
        ; wchar_t * string.  DCC wchar_t is 16-bit for L"..." literals.
        ; Print the low byte as ASCII and ignore the high byte.
        push    hl
        call    pf_arg_hl
