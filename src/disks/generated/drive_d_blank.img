␀xTLfloat_hook:
        dw      pf_float_stub

; printf/sprintf/fprintf shared sink and buffer (here so they stay in the
; _␀TLtf block; placing them elsewhere forces dccrtlstrip to keep that block)
pf_sink:        dw      0       ; 0=console, 0FFFFh␀bTLfer
pf_bufptr:      dw      0       ; write pointer for sprintf/fprintf
__pf_cnt:       dw      0       ; char count saved␀ѕTLfprintf
__pf_fbuf:      ds      256     ; static buffer for fprintf


; ---- float-enabled printf (-ffloatio) ----------␀TL----------------
        public  _exit
_exit:
        push    ix
        ld      ix,0
        add     ix,sp
        ld␀©TL  l,(ix+4)
        ld      h,(ix+5)
        pop     ix
        call    __cpm_set_retcode
        jp      0000h

; ----␀рTL----------------------------------------------------
; CP/M 3 program return code support.
;
; CP/M 3 / CP/M Plus BDOS fu␀ TLon 108 (P_CODE):
;     C  = 6Ch
;     DE = program return code to set
;     DE = FFFFh means get current code, so avoid u␀¶TL FFFFh as a
;          set value.  For exit(-1), use 00FFh, matching the common
;          8-bit process-status convention␀“TL
; CP/M 2.2 safely ignores unsupported BDOS functions, and emulators can
; intercept this call directly, so no version che␀TLs needed.
; ------------------------------------------------------------
__cpm_set_retcode:
        ; input: HL = C int s␀FTLs / main return value

        ; If status is FFFFh, remap to 00FFh.  DE=FFFFh is the
        ; P_CODE "get" sentinel, no␀dTLsettable return code.
        ld      a,h
        and     l
        inc     a
        jr      nz,csr_not_minus1
       ␀ЋTL     hl,00ffh
csr_not_minus1:

        ex      de,hl           ; DE = status
        ld      c,6ch           ; P_CODE: g␀ƒTLet program return code
        call    5
        ret


	end	start
