ь€€ЦГ␀␀␀␀:Ы€€іW␀␀ҐТ€€v␀␀␀␀ш»€€YI␀␀ѓX␀␀∞О€€йЦ€€еў€€ј“€€нЭ€€%Я€€Чч€€RW␀␀Е€€З	␀␀,␀␀_␀␀$␀␀OН␀␀_і€€цЧ€€у†€€<␀␀8<␀␀T␀␀”P␀␀ћR␀␀џC␀␀©€€ГИ€€3У€€1Ъ€€ЩЕ€€␀␀Ь&␀␀Ґ␀␀jі€€"O€€вж€€ИЏ€€юN␀␀«X␀␀ш␀␀§»€€Ќћ€€∆[␀␀iN␀␀␀␀™€€,’€€хҐ€€сЛ␀␀ь√€€ƒГ␀␀п€€N]␀␀6C␀␀∆I␀␀Ы®€€Г$␀␀Lу€€}␀␀Ёћ€€ѕ_␀␀Ъ␀␀эл€€"А€€їћ€€д"␀␀З␀␀s>␀␀ЁЗ€€H±€€ J␀␀Ѓ<␀␀L∞€€/3␀␀      LXI     H,PHR60         ; phrase + " # "
        CALL    COUTS
        LHLD    LINES           ; counter = LINES + 1
        INX     H
        CALL    PRDEC
        LXI     H,SUFFIX        ; ESC [ 0 m CR LF
        CALL    COUTS
        LHLD    LINES           ; LINES = LINES + 1
        INX     H
        SHLD    LINES
        LDA     CIDX            ; advance color index (mod NCOLOR)
        INR     A
        CPI     NCOLOR
        JC      CSET
        XRA     A
CSET:   STA     CIDX
        CALL    CKESC           ; ESC pressed?
        ORA     A
        JNZ     LESC            ; yes -> stop early
        JMP     LOOP
LESC:   MVI     A,1
        STA     ESCFLG          ; remember ESC so we don't rerun
        JMP     LDONE

; --- latch elapsed seconds, keep the low 16 bits ------------------------
LDONE:  MVI     A,1
        OUT     SWPORT          ; OUT 37,1 -> latch elapsed seconds
        IN      RDPORT          ; byte 0 (MSB) - ignore
        IN      RDPORT          ; byte 1       - ignore
        IN      RDPORT          ; byte 2
        MOV     H,A
        IN      RDPORT          ; byte 3 (LSB)
        MOV     L,A
